#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main(void) {
    char buf[64];
    printf("Guess the number (1-5): ");
    if(!fgets(buf, sizeof buf, stdin)) return 0;
    // strip newline
    buf[strcspn(buf, "\r\n")] = 0;
    if (strcmp(buf, "3") == 0) {
        printf("Correct!\n");
    } else {
        printf("Wrong!\n");
    }
    return 0;
}
